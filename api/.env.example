NODE_ENV=development
# Runtime environment label: development | staging | production.
# Dev shortcuts (default member password, /api/dev/accounts, quick login) are
# refused whenever NODE_ENV or APP_ENV is production (or APP_ENV=staging).
APP_ENV=development
# DEV ONLY: password for seeded demo members (member1..member5@example.com) and
# for members approved in development. Ignored in production. Min 10 chars.
# Leave empty to disable demo members and the dev quick-login list.
DEV_DEFAULT_MEMBER_PASSWORD=
PORT=3000
# Must match PMA_DB_PASSWORD in the root .env when using docker compose.
DATABASE_URL="mysql://pma:change_me_db_password@localhost:3306/private_members"
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
STORAGE_ROOT=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/uploads
MAIL_FROM=noreply@example.com
MAIL_HOST=localhost
MAIL_PORT=1025
APP_PUBLIC_URL=http://localhost:8080
ADMIN_PUBLIC_URL=http://localhost:8081
SUPER_ADMIN_EMAIL=admin@example.com
# Seed (npx prisma db seed). Production/staging: both are REQUIRED or the seed refuses to run.
# Development: if empty, the seed generates random values and prints them once.
# The API e2e tests read the same two values.
SEED_ADMIN_PASSWORD=
SEED_INVITE_CODE=
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
PRIVACY_VERSION=1.0
TERMS_VERSION=1.0
FOUNDING_MEMBER_CAP=20
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=10
STORAGE_PROVIDER=local
STORAGE_SIGNING_SECRET=replace_storage_signing_secret
API_PUBLIC_URL=http://localhost:3000
MEDIA_MAX_IMAGE_BYTES=12582912
# S3 (when STORAGE_PROVIDER=s3)
# AWS_REGION=us-east-1
# S3_BUCKET=private-members-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
MEDIA_MAX_VIDEO_BYTES=209715200

# Socket.IO: in-memory (default). Set redis when horizontal scaling (see docs/realtime-redis-adapter.md)
REALTIME_ADAPTER=in-memory
# REDIS_URL=redis://localhost:6379
QR_HMAC_SECRET=replace_with_qr_hmac_secret

# Staff 2FA (set true in production)
STAFF_2FA_REQUIRED=false

# Scheduled jobs
SCHEDULE_ENABLED=true
VERIFICATION_DOC_RETENTION_DAYS=30

# Mail: console | smtp | ses
MAIL_PROVIDER=console
# MAIL_PROVIDER=smtp
# MAIL_HOST=localhost
# MAIL_PORT=1025

# Push: noop | fcm
PUSH_PROVIDER=noop
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_PATH=

# Stage 7 security / privacy
JWT_KID=v1
# JWT_ACCESS_SECRET_PREVIOUS=
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_MINUTES=15
HIBP_ENABLED=false
ACCOUNT_DELETION_GRACE_DAYS=14
AWS_SECRETS_ENABLED=false
# AWS_SECRET_ID=private-members/production/app
SWAGGER_ENABLED=true
