# Runs "prisma migrate deploy" ONCE per deployment, on the leader instance only,
# after dependencies are installed and BEFORE the new version goes live.
# If it fails, the deployment stops and the previous version keeps running.
# DATABASE_URL comes from the EB environment (Secrets Manager / Parameter Store reference).
container_commands:
  01_prisma_migrate_deploy:
    command: "npx --no-install prisma migrate deploy"
    leader_only: true
