// Private Members App — Phase 1 full schema (Stage 1 / M1+M2)
// MySQL 8 / MariaDB 11 compatible via Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum RoleName {
  member
  moderator
  admin
  super_admin
}

enum UserStatus {
  pending_password // approved but has not set password yet
  active
  suspended
  deleted
}

enum ApplicationStatus {
  submitted
  under_review
  more_info_needed
  approved
  declined
}

enum MembershipStatus {
  active
  dues_due
  overdue
  suspended
}

enum VehicleVerificationStatus {
  draft
  submitted
  approved
  rejected
}

enum MediaOwnerType {
  post
  vehicle
  business_page
  verification
  profile
  message
  event
}

enum MediaKind {
  image
  video
  document
  other
}

enum ConversationType {
  direct
}

enum RsvpStatus {
  going
  maybe
  not_going
  waitlisted
}

enum EventStatus {
  draft
  published
  cancelled
  completed
}

enum RsvpPaymentStatus {
  unpaid
  paid
  waived
}

enum SpeakerRole {
  chef
  guest
  keynote
  roundtable
}

enum NotificationChannel {
  in_app
  push
  email
}

enum ReportTargetType {
  post
  comment
  message
  user
  thread_comment
}

enum ReportStatus {
  open
  reviewing
  resolved
  dismissed
}

enum InviteStatus {
  active
  used
  revoked
  expired
}

// ─── Auth & users ────────────────────────────────────────

model User {
  id               String           @id @default(uuid()) @db.Char(36)
  email            String           @unique @db.VarChar(255)
  passwordHash     String?          @map("password_hash") @db.VarChar(255)
  firstName        String           @map("first_name") @db.VarChar(100)
  lastName         String           @map("last_name") @db.VarChar(100)
  phone            String?          @db.VarChar(40)
  company          String?          @db.VarChar(200)
  title            String?          @db.VarChar(200)
  city             String?          @db.VarChar(100)
  state            String?          @db.VarChar(100)
  bio              String?          @db.Text
  avatarKey        String?          @map("avatar_key") @db.VarChar(500)
  showEmail        Boolean          @default(false) @map("show_email")
  showPhone        Boolean          @default(false) @map("show_phone")
  showEventsAttended Boolean        @default(true) @map("show_events_attended")
  hiddenAt         DateTime?        @map("hidden_at")
  status           UserStatus       @default(pending_password)
  foundingMember   Boolean          @default(false) @map("founding_member")
  membershipStatus MembershipStatus @default(dues_due) @map("membership_status")
  renewalDate      DateTime?        @map("renewal_date") @db.Date
  emailVerifiedAt  DateTime?        @map("email_verified_at")
  totpSecret       String?          @map("totp_secret") @db.VarChar(255)
  totpEnabledAt    DateTime?        @map("totp_enabled_at")
  totpRecoveryHashes String?        @map("totp_recovery_hashes") @db.Text // JSON array of sha256 hashes
  failedLoginCount Int              @default(0) @map("failed_login_count")
  lockedUntil      DateTime?        @map("locked_until")
  deletionRequestedAt DateTime?     @map("deletion_requested_at")
  deletionScheduledAt DateTime?     @map("deletion_scheduled_at")
  deletedAt        DateTime?        @map("deleted_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  roles                    UserRole[]
  notificationPreference   NotificationPreference?
  applications             MemberApplication[] @relation("ApplicantUser")
  reviewedApplications     MemberApplication[] @relation("ReviewerUser")
  vehicles                 Vehicle[]
  businessPage             BusinessPage?
  posts                    Post[]
  comments                 Comment[]
  likes                    Like[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  blocksInitiated          UserBlock[]          @relation("Blocker")
  blocksReceived           UserBlock[]          @relation("Blocked")
  threadMutes              ThreadMute[]
  eventRsvps               EventRsvp[]
  eventCheckins            EventCheckin[]
  threadComments           ThreadComment[]
  notifications            Notification[]
  duesRecords              DuesRecord[]
  reportsFiled             Report[]            @relation("Reporter")
  reportsResolved          Report[]            @relation("ReportResolver")
  auditLogs                AuditLog[]
  devices                  Device[]
  refreshTokens            RefreshToken[]
  invitesCreated           Invite[]            @relation("InviteCreator")
  passwordResets           PasswordReset[]

  @@index([status])
  @@index([membershipStatus])
  @@index([foundingMember])
  @@map("users")
}

model Role {
  id          String     @id @default(uuid()) @db.Char(36)
  name        RoleName   @unique
  description String?    @db.VarChar(255)
  createdAt   DateTime   @default(now()) @map("created_at")
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Char(36)
  roleId     String   @map("role_id") @db.Char(36)
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Char(36)
  userId         String    @map("user_id") @db.Char(36)
  tokenHash      String    @map("token_hash") @db.VarChar(255)
  familyId       String    @map("family_id") @db.Char(36)
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  replacedById   String?   @map("replaced_by_id") @db.Char(36)
  createdAt      DateTime  @default(now()) @map("created_at")
  userAgent      String?   @map("user_agent") @db.VarChar(500)
  ipAddress      String?   @map("ip_address") @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("password_resets")
}

model Invite {
  id              String       @id @default(uuid()) @db.Char(36)
  code            String       @unique @db.VarChar(64)
  createdById     String?      @map("created_by_id") @db.Char(36)
  emailHint       String?      @map("email_hint") @db.VarChar(255)
  maxUses         Int          @default(1) @map("max_uses")
  useCount        Int          @default(0) @map("use_count")
  status          InviteStatus @default(active)
  expiresAt       DateTime?    @map("expires_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  createdBy    User?               @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  applications MemberApplication[]

  @@index([status])
  @@map("invites")
}

// ─── Membership applications ─────────────────────────────

model MemberApplication {
  id                    String            @id @default(uuid()) @db.Char(36)
  inviteId              String?           @map("invite_id") @db.Char(36)
  userId                String?           @map("user_id") @db.Char(36) // set on approval
  email                 String            @db.VarChar(255)
  firstName             String            @map("first_name") @db.VarChar(100)
  lastName              String            @map("last_name") @db.VarChar(100)
  phone                 String?           @db.VarChar(40)
  company               String?           @db.VarChar(200)
  title                 String?           @db.VarChar(200)
  city                  String?           @db.VarChar(100)
  state                 String?           @db.VarChar(100)
  vehicleMake           String            @map("vehicle_make") @db.VarChar(100)
  vehicleModel          String            @map("vehicle_model") @db.VarChar(100)
  vehicleYear           Int               @map("vehicle_year")
  vehicleEstimatedValue Int               @map("vehicle_estimated_value") // USD
  status                ApplicationStatus @default(submitted)
  internalNote          String?           @map("internal_note") @db.Text
  declineReason         String?           @map("decline_reason") @db.Text
  moreInfoMessage       String?           @map("more_info_message") @db.Text
  consentPrivacyAt      DateTime          @map("consent_privacy_at")
  consentPrivacyVersion String            @map("consent_privacy_version") @db.VarChar(32)
  consentTermsAt        DateTime          @map("consent_terms_at")
  consentTermsVersion   String            @map("consent_terms_version") @db.VarChar(32)
  reviewedById          String?           @map("reviewed_by_id") @db.Char(36)
  reviewedAt            DateTime?         @map("reviewed_at")
  foundingRequested     Boolean           @default(false) @map("founding_requested")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  invite      Invite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  user        User?   @relation("ApplicantUser", fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy  User?   @relation("ReviewerUser", fields: [reviewedById], references: [id], onDelete: SetNull)
  proofMedia  Media[] @relation("ApplicationProof")

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("member_applications")
}

// ─── Profiles content ────────────────────────────────────

model Vehicle {
  id                 String                     @id @default(uuid()) @db.Char(36)
  userId             String                     @map("user_id") @db.Char(36)
  make               String                     @db.VarChar(100)
  model              String                     @db.VarChar(100)
  year               Int
  color              String?                    @db.VarChar(64)
  plateNumber        String?                    @map("plate_number") @db.VarChar(32)
  blurPlate          Boolean                    @default(true) @map("blur_plate")
  estimatedValueUsd  Int?                       @map("estimated_value_usd")
  description        String?                    @db.Text
  verificationStatus VehicleVerificationStatus  @default(draft) @map("verification_status")
  isPrimary          Boolean                    @default(false) @map("is_primary")
  hiddenAt           DateTime?                  @map("hidden_at")
  deletedAt          DateTime?                  @map("deleted_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media[]

  @@index([userId])
  @@index([verificationStatus])
  @@map("vehicles")
}

model BusinessPage {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @unique @map("user_id") @db.Char(36)
  companyName String    @map("company_name") @db.VarChar(200)
  logoKey     String?   @map("logo_key") @db.VarChar(500)
  services    String?   @db.Text
  background  String?   @db.Text
  website     String?   @db.VarChar(500)
  contactEmail String?  @map("contact_email") @db.VarChar(255)
  contactPhone String?  @map("contact_phone") @db.VarChar(40)
  showContactEmail Boolean @default(true) @map("show_contact_email")
  showContactPhone Boolean @default(false) @map("show_contact_phone")
  hiddenAt    DateTime? @map("hidden_at")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("business_pages")
}

// ─── Feed ────────────────────────────────────────────────

model Post {
  id              String    @id @default(uuid()) @db.Char(36)
  authorId        String    @map("author_id") @db.Char(36)
  body            String?   @db.Text
  linkUrl         String?   @map("link_url") @db.VarChar(1000)
  linkTitle       String?   @map("link_title") @db.VarChar(500)
  linkDescription String?   @map("link_description") @db.VarChar(1000)
  linkImageUrl    String?   @map("link_image_url") @db.VarChar(1000)
  sharedFromPostId String?  @map("shared_from_post_id") @db.Char(36)
  hiddenAt        DateTime? @map("hidden_at")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  sharedFrom Post?     @relation("PostShares", fields: [sharedFromPostId], references: [id], onDelete: SetNull)
  shares     Post[]    @relation("PostShares")
  media          Media[]
  comments       Comment[]
  likes          Like[]
  sharedMessages Message[]

  @@index([authorId])
  @@index([createdAt])
  @@index([hiddenAt])
  @@map("posts")
}

model Media {
  id            String         @id @default(uuid()) @db.Char(36)
  ownerType     MediaOwnerType @map("owner_type")
  ownerId       String         @map("owner_id") @db.Char(36)
  kind          MediaKind      @default(image)
  storageKey    String         @map("storage_key") @db.VarChar(500)
  mimeType      String         @map("mime_type") @db.VarChar(120)
  sizeBytes     Int            @map("size_bytes")
  width         Int?
  height        Int?
  durationSec   Int?           @map("duration_sec")
  posterKey      String?        @map("poster_key") @db.VarChar(500)
  isPrivate     Boolean        @default(true) @map("is_private")
  thumbnailKey  String?        @map("thumbnail_key") @db.VarChar(500)
  exifStripped  Boolean        @default(false) @map("exif_stripped")
  scanStatus    String         @default("pending") @map("scan_status") @db.VarChar(32)
  hiddenAt      DateTime?      @map("hidden_at")
  applicationId String?        @map("application_id") @db.Char(36)
  postId        String?        @map("post_id") @db.Char(36)
  vehicleId     String?        @map("vehicle_id") @db.Char(36)
  deletedAt     DateTime?      @map("deleted_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  application MemberApplication? @relation("ApplicationProof", fields: [applicationId], references: [id], onDelete: SetNull)
  post        Post?              @relation(fields: [postId], references: [id], onDelete: SetNull)
  vehicle     Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([ownerType, ownerId])
  @@index([applicationId])
  @@index([postId])
  @@map("media")
}

model Comment {
  id        String    @id @default(uuid()) @db.Char(36)
  postId    String    @map("post_id") @db.Char(36)
  authorId  String    @map("author_id") @db.Char(36)
  body      String    @db.Text
  hiddenAt  DateTime? @map("hidden_at")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("comments")
}

model Like {
  userId    String   @map("user_id") @db.Char(36)
  postId    String   @map("post_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@map("likes")
}

// ─── Messaging ───────────────────────────────────────────

model Conversation {
  id        String           @id @default(uuid()) @db.Char(36)
  type      ConversationType @default(direct)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  conversationId String    @map("conversation_id") @db.Char(36)
  userId         String    @map("user_id") @db.Char(36)
  lastReadAt     DateTime? @map("last_read_at")
  joinedAt       DateTime  @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(uuid()) @db.Char(36)
  conversationId String    @map("conversation_id") @db.Char(36)
  senderId       String    @map("sender_id") @db.Char(36)
  body           String?   @db.Text
  linkUrl        String?   @map("link_url") @db.VarChar(2000)
  sharedPostId   String?   @map("shared_post_id") @db.Char(36)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  sharedPost   Post?        @relation(fields: [sharedPostId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([sharedPostId])
  @@map("messages")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Char(36)
  blockedId String   @map("blocked_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model ThreadMute {
  threadId  String   @map("thread_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  thread EventThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
  @@index([userId])
  @@map("thread_mutes")
}

// ─── Events ──────────────────────────────────────────────

model Event {
  id             String      @id @default(uuid()) @db.Char(36)
  title          String      @db.VarChar(255)
  description    String?     @db.Text
  venueName      String?     @map("venue_name") @db.VarChar(255)
  venueAddress   String?     @map("venue_address") @db.VarChar(500)
  startsAt       DateTime    @map("starts_at")
  endsAt         DateTime?   @map("ends_at")
  timezone       String      @default("America/New_York") @db.VarChar(64)
  status         EventStatus @default(draft)
  coverImageKey  String?     @map("cover_image_key") @db.VarChar(500)
  capacity       Int?
  rsvpCutoffAt   DateTime?   @map("rsvp_cutoff_at")
  feeUsdCents    Int         @default(100000) @map("fee_usd_cents")
  paymentLinkUrl String?     @map("payment_link_url") @db.VarChar(1000)
  deletedAt      DateTime?   @map("deleted_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  speakers  EventSpeaker[]
  rsvps     EventRsvp[]
  checkins  EventCheckin[]
  thread    EventThread?

  @@index([startsAt])
  @@index([status])
  @@map("events")
}

model EventSpeaker {
  id        String      @id @default(uuid()) @db.Char(36)
  eventId   String      @map("event_id") @db.Char(36)
  name      String      @db.VarChar(200)
  role      SpeakerRole
  bio       String?     @db.Text
  topic     String?     @db.VarChar(500)
  hostName  String?     @map("host_name") @db.VarChar(200)
  menuNotes String?     @map("menu_notes") @db.Text
  sortOrder Int         @default(0) @map("sort_order")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_speakers")
}

model EventRsvp {
  id            String            @id @default(uuid()) @db.Char(36)
  eventId       String            @map("event_id") @db.Char(36)
  userId        String            @map("user_id") @db.Char(36)
  status        RsvpStatus        @default(going)
  paymentStatus RsvpPaymentStatus @default(unpaid) @map("payment_status")
  qrNonce       String            @unique @map("qr_nonce") @db.VarChar(128)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@map("event_rsvps")
}

model EventCheckin {
  id          String   @id @default(uuid()) @db.Char(36)
  eventId     String   @map("event_id") @db.Char(36)
  userId      String   @map("user_id") @db.Char(36)
  checkedInAt DateTime @default(now()) @map("checked_in_at")
  checkedInBy String?  @map("checked_in_by") @db.Char(36)
  walkIn      Boolean  @default(false) @map("walk_in")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@map("event_checkins")
}

model EventThread {
  id        String   @id @default(uuid()) @db.Char(36)
  eventId   String   @unique @map("event_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  event    Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  comments ThreadComment[]
  mutes    ThreadMute[]

  @@map("event_threads")
}

model ThreadComment {
  id        String    @id @default(uuid()) @db.Char(36)
  threadId  String    @map("thread_id") @db.Char(36)
  authorId  String    @map("author_id") @db.Char(36)
  body      String    @db.Text
  hiddenAt  DateTime? @map("hidden_at")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  thread EventThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("thread_comments")
}

// ─── Notifications, dues, moderation, audit ──────────────

model Notification {
  id        String              @id @default(uuid()) @db.Char(36)
  userId    String              @map("user_id") @db.Char(36)
  channel   NotificationChannel @default(in_app)
  title     String              @db.VarChar(255)
  body      String              @db.Text
  dataJson  String?             @map("data_json") @db.Text
  readAt    DateTime?           @map("read_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model DuesRecord {
  id              String           @id @default(uuid()) @db.Char(36)
  userId          String           @map("user_id") @db.Char(36)
  status          MembershipStatus @default(dues_due)
  amountUsdCents  Int?             @map("amount_usd_cents")
  periodStart     DateTime?        @map("period_start") @db.Date
  periodEnd       DateTime?        @map("period_end") @db.Date
  externalRef     String?          @map("external_ref") @db.VarChar(255) // Stripe Payment Link / receipt id
  notes           String?          @db.Text
  markedPaidAt    DateTime?        @map("marked_paid_at")
  markedPaidById  String?          @map("marked_paid_by_id") @db.Char(36)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("dues_records")
}

model Report {
  id           String           @id @default(uuid()) @db.Char(36)
  reporterId   String           @map("reporter_id") @db.Char(36)
  targetType   ReportTargetType @map("target_type")
  targetId     String           @map("target_id") @db.Char(36)
  reason       String           @db.Text
  status       ReportStatus     @default(open)
  resolvedById String?          @map("resolved_by_id") @db.Char(36)
  resolution   String?          @db.Text
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  reporter   User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([targetType, targetId])
  @@map("reports")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  actorId    String?  @map("actor_id") @db.Char(36)
  action     String   @db.VarChar(100)
  targetType String?  @map("target_type") @db.VarChar(64)
  targetId   String?  @map("target_id") @db.Char(36)
  metadata   String?  @db.Text // JSON
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Device {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @map("user_id") @db.Char(36)
  fcmToken   String    @map("fcm_token") @db.VarChar(512)
  platform   String    @db.VarChar(32) // ios | android | web
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fcmToken])
  @@index([userId])
  @@map("devices")
}


model NotificationPreference {
  userId           String   @id @map("user_id") @db.Char(36)
  pushMessages     Boolean  @default(true) @map("push_messages")
  pushEvents       Boolean  @default(true) @map("push_events")
  pushThreads      Boolean  @default(true) @map("push_threads")
  pushDues         Boolean  @default(true) @map("push_dues")
  pushApplications Boolean  @default(true) @map("push_applications")
  emailEvents      Boolean  @default(true) @map("email_events")
  emailDues        Boolean  @default(true) @map("email_dues")
  emailApplications Boolean @default(true) @map("email_applications")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model JobLock {
  name       String   @id @db.VarChar(100)
  lockedAt   DateTime @map("locked_at")
  lockedBy   String   @map("locked_by") @db.VarChar(100)
  expiresAt  DateTime @map("expires_at")

  @@map("job_locks")
}
